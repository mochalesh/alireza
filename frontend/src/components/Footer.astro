---
/**
 * Footer — the site's structural workhorse.
 *
 * Comparison pages and, later, the Arabic city pages live here rather than in
 * the header, so it has to be complete on every page: it is how crawlers and
 * visitors reach the long tail. Links are built from the same data the rest
 * of the site uses, so a page that does not exist cannot be linked from here
 * by accident, and a capability that is not live carries its SOON label here
 * too — the brief names the footer link explicitly.
 */
import { TRADES, CAPABILITIES, COMPARISONS, RESOURCES, COMPANY, AR_SITE } from '../data/site.js';

interface Props {
  lang?: 'en' | 'ar';
}

const { lang = 'en' } = Astro.props;

const year = 2026;

/*
 * Only built pages get a link. A column with nothing built yet does not
 * render at all — an empty heading is a promise the footer cannot keep.
 */
const built = (list) => list.filter((i) => i.built);

const columns = [
  { label: 'For your trade', items: built(TRADES).map((t) => ({ label: t.name, href: `/for/${t.slug}` })) },
  {
    label: 'What you get',
    items: built(CAPABILITIES).map((c) => ({
      label: c.name,
      href: `/features/${c.slug}`,
      soon: c.status !== 'live',
    })),
  },
  { label: 'Compare', items: built(COMPARISONS).map((c) => ({ label: `Widgeta vs ${c.name}`, href: `/vs/${c.slug}` })) },
  { label: 'Resources', items: built(RESOURCES) },
  { label: 'Company', items: built(COMPANY) },
].filter((col) => col.items.length > 0);
---

<footer class="ftr">
  <div class="ftr__in">
    <div class="ftr__cols">
      {
        columns.map((col) => (
          <nav class="ftr__col" aria-label={col.label}>
            <span class="ftr__head">{col.label}</span>
            {col.items.map((item) => (
              <a href={item.href}>
                {item.label}
                {item.soon && <span class="soon"> SOON</span>}
              </a>
            ))}
          </nav>
        ))
      }
    </div>

    <div class="ftr__bar">
      <span class="brand">
        <span class="brand__mark" aria-hidden="true">W</span>
        <span class="brand__word">widgeta</span>
      </span>
      <span class="ftr__legal">© {year} Widgeta · widgeta.app</span>
      {
        (lang === 'ar' || AR_SITE.built) && (
          <a class="langchip" href={lang === 'ar' ? '/' : AR_SITE.href}>EN · العربية</a>
        )
      }
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--ink);
    color: var(--paper);
  }

  .ftr__in {
    max-inline-size: var(--shell);
    margin-inline: auto;
    padding: clamp(40px, 6vw, 64px) var(--gutter);
  }

  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr));
    gap: var(--s-8);
  }

  .ftr__col {
    display: grid;
    gap: 2px;
    align-content: start;
  }

  .ftr__head {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--amber);
    margin-block-end: var(--s-2);
  }

  .ftr__col a {
    display: flex;
    align-items: center;
    min-block-size: var(--tap);
    color: var(--paper);
    font-size: var(--fs-small);
    opacity: .85;
  }

  .ftr__col a:hover {
    opacity: 1;
    color: var(--amber);
  }

  .soon {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    color: var(--amber);
    margin-inline-start: 6px;
  }

  .ftr__bar {
    border-block-start: 1px solid rgba(250, 247, 242, .15);
    margin-block-start: var(--s-12);
    padding-block-start: var(--s-6);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .brand__mark {
    inline-size: 22px;
    block-size: 22px;
    border-radius: var(--r-tag);
    background: var(--amber);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 14px;
    color: var(--ink);
  }

  .brand__word {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 17px;
  }

  .ftr__legal {
    font-size: 14px;
    opacity: .7;
  }

  .langchip {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
    padding-inline: var(--s-3);
    border: 1px solid rgba(250, 247, 242, .3);
    border-radius: var(--r-pill);
    color: var(--paper);
    font-size: 14px;
    white-space: nowrap;
  }

  .langchip:hover {
    border-color: var(--amber);
    color: var(--amber);
  }
</style>
