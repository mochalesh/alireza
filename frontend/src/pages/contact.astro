---
/**
 * Contact.
 *
 * A page, not a form. There is no endpoint to post a form to yet, and a
 * contact form that silently drops what someone typed is the worst possible
 * version of this page. Email and phone are links that work in one tap from
 * the van; the form arrives when there is something behind it.
 */
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { CONTACT, PLACEHOLDER } from '../data/company.js';
import { SITE_URL, APP_URL, AR_SITE } from '../data/site.js';

const title = 'Contact Widgeta — Talk to a Person | Widgeta';
const description =
  'Questions before you start, press, partnerships or a problem with your site. Email or call and a person answers within one business day.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${SITE_URL}/contact` },
    ],
  },
];

const reasons = [
  { t: 'Before you sign up', d: 'Anything you want answered before you spend a monthly fee. Ask the awkward ones.' },
  { t: 'A problem with your site', d: 'Something wrong, missing or out of date on a site Widgeta built. Include the address.' },
  { t: 'Press and partnerships', d: 'Media, integrations, or working together in a new market.' },
];
---

<Base
  title={title}
  description={description}
  path="/contact"
  altPath={AR_SITE.built ? '/ar/contact' : undefined}
  schema={schema}
>
  <div class="shell">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
  </div>

  <section class="head">
    <div class="shell">
      <div class="measure">
        <h1>Talk to a person.</h1>
        <p class="para muted">
          Write or call and someone answers within {CONTACT.responseWindow} — no
          ticket numbers, no chatbot maze. If you already have a Widgeta site,
          mention its address and we can look at it while we talk.
        </p>

        <div class="ways">
          <a class="card way" href={`mailto:${CONTACT.email}`}>
            <span class="way__label">Email</span>
            <span class="way__value">{CONTACT.email}</span>
            <span class="muted way__note">Best for anything with detail.</span>
          </a>

          <div class="card way">
            <span class="way__label">Phone / text</span>
            <span class="way__value">{CONTACT.phone}</span>
            <span class="muted way__note">Business hours, US.</span>
          </div>

          <div class="card way">
            <span class="way__label">Gulf (WhatsApp)</span>
            <span class="way__value">{CONTACT.whatsapp}</span>
            <span class="muted way__note">The fastest route in Saudi and the UAE.</span>
          </div>
        </div>

        {PLACEHOLDER && (
          <p class="notice">Contact details are placeholders until launch.</p>
        )}
      </div>
    </div>
  </section>

  <section class="section reasons-sec">
    <div class="shell">
      <h2>What people usually write about</h2>
      <div class="grid-auto reasons">
        {reasons.map((r) => (
          <div class="card">
            <h3 class="reason__t">{r.t}</h3>
            <p class="muted">{r.d}</p>
          </div>
        ))}
      </div>

      <p class="signup muted">
        Want to start rather than ask? <a href={`${APP_URL}/signup`}>Answering the
        questions takes about two minutes →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .head { padding-block: var(--s-4) var(--section-y); }

  .para {
    margin-block-start: var(--s-6);
    font-size: var(--fs-lead);
  }

  .ways {
    display: grid;
    gap: var(--s-4);
    margin-block-start: var(--s-8);
  }

  .way {
    display: grid;
    gap: 4px;
    min-block-size: var(--tap);
  }

  .way__label {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .way__value {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 26px;
  }

  a.way:hover {
    border-color: var(--amber);
    color: var(--ink);
  }

  .way__note { font-size: 14px; }

  .notice {
    display: inline-block;
    margin-block-start: var(--s-6);
    padding: var(--s-2) var(--s-3);
    border: 1px dashed var(--soon-line);
    border-radius: var(--r-tag);
    background: var(--soon-bg);
    color: var(--soon-text);
    font-size: 14px;
    font-weight: 600;
  }

  .reasons-sec { background: var(--putty); }

  .reasons { margin-block-start: var(--s-8); }

  .reason__t { font-size: 20px; margin-block-end: var(--s-2); }

  .signup {
    margin-block-start: var(--s-8);
    font-size: var(--fs-small);
  }

  .signup a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
    color: var(--amber-text);
    font-weight: 700;
  }
</style>
