---
/**
 * Pricing.
 *
 * The brief describes this page becoming a real configurator once more than
 * one optional capability exists. Today exactly one does, and it is not for
 * sale — so the page is a single price card plus a coming-soon card, and the
 * summary column reflects the one choice a visitor can actually make: whether
 * to be told when call answering lands.
 *
 * That choice changes nothing about the price, and the summary says so. A
 * toggle that appeared to add a line item to a total would be selling
 * something that cannot be bought.
 */
import Base from '../layouts/Base.astro';
import '../styles/pricing.css';
import FaqList from '../components/FaqList.astro';
import { SITE_URL, APP_URL, PRICE, PRIMARY_CTA, AR_SITE } from '../data/site.js';
import { ROADMAP } from '../data/home.js';

const price = PRICE.en;

const included = [
  {
    tag: 'Website',
    line: 'A complete website with your name on it',
  },
  {
    tag: 'SEO',
    line: 'Found on Google in every area you serve',
  },
  {
    tag: 'Content',
    line: 'New pages every month, matched to local searches',
  },
];

const faqs = [
  {
    q: 'Is there a contract?',
    a: 'No. Month to month, cancel whenever you want. If you cancel, the site you built is still yours to take with you.',
  },
  {
    q: 'Do I have to write anything or learn software?',
    a: 'No. You answer a few questions once — about 2 minutes, like replying to texts. Everything after that happens on its own.',
  },
  {
    q: 'What do I actually get for the money?',
    a: 'A complete website, a page for every service in every area you cover, and new pages each month matched to what neighbors search. You can watch it grow — but you never have to.',
  },
];

const title = 'Pricing — One Flat Monthly Price, No Contract | Widgeta';
const description =
  'Website, SEO and content for home-service businesses at one flat monthly price. No setup fee, no contract, and the site stays yours if you leave.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Widgeta',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: SITE_URL,
    offers: {
      '@type': 'Offer',
      price: price.amount,
      priceCurrency: price.currency,
      url: `${SITE_URL}/pricing`,
      availability: 'https://schema.org/InStock',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

{/* The Arabic pricing page is a true equivalent — same product, same one
    price, same page — so this pair is real rather than convenient. */}
<Base
  title={title}
  description={description}
  path="/pricing"
  altPath={AR_SITE.built ? '/ar/pricing' : undefined}
  schema={schema}
>
  <div class="pricingpage">
  <section class="head">
    <div class="shell">
      <h1>Pick what you want done. The price adds itself.</h1>
      <p class="head__sub">
        Three things every business needs come standard. Add more when you're
        ready. One monthly price, no contract, cancel anytime.
      </p>
    </div>
  </section>

  <section class="section pricing">
    <div class="shell pricing__grid">
      <!-- Left: what you can buy, and what you cannot yet ---------------- -->
      <div class="stack" style="--flow: var(--s-6)">
        <div class="card plan">
          <span class="plan__label">Always included</span>

          <p class="plan__price">
            <span class="plan__amount">{price.display}</span>
            <span class="plan__period">{price.period}</span>
          </p>

          <h2 class="plan__h">Neighbors find you on Google</h2>
          <p class="muted">
            The foundation every business gets: a complete site, ranking work in
            every area you serve, and fresh pages answering what locals search
            for. It runs itself.
          </p>

          <div class="plan__tags">
            {included.map((i) => <span class="tag tag--live">{i.tag}</span>)}
          </div>
        </div>

        <div class="card soon">
          <div class="soon__top">
            <span class="tag tag--soon">Coming soon</span>
            <span class="muted soon__note">Pricing announced at launch</span>
          </div>

          <h2 class="plan__h">Every call answered — even on a ladder</h2>
          <p class="muted">
            {/*
              The design opened this with "about 1 in 4 calls to the trades goes
              unanswered". We cannot source that figure, and the brief forbids
              stating one we cannot. The argument does not need it.
            */}
            A call you miss on a job is a job someone else takes. Widgeta will
            pick up, take the job details, and send them straight to you.
          </p>

          <div class="switchrow">
            <label class="switch">
              <input type="checkbox" data-notify-toggle />
              <span class="switch__track" aria-hidden="true"><span class="switch__knob"></span></span>
              <span class="switch__label">Tell me when this launches</span>
            </label>
          </div>

          <form class="notify" hidden data-notify-form action="/pricing" method="get">
            <label class="sr-only" for="soon-email">Email address</label>
            <input
              class="notify__input"
              id="soon-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@yourbusiness.com"
            />
            <button class="btn btn--ink" type="submit">Notify me</button>
          </form>

          <p class="notify__done" hidden data-notify-done>
            <span aria-hidden="true">✓</span> You're on the list — we'll email you the day it launches.
          </p>
        </div>

        <div class="card roadmap-card">
          <span class="plan__label">Later, as you grow</span>
          <p class="muted">On the roadmap — added over time, only if you want them:</p>
          <div class="roadmap__chips">
            {ROADMAP.map((r) => <span class="chip">{r}</span>)}
          </div>
        </div>
      </div>

      <!-- Right: the running summary ------------------------------------- -->
      <aside class="ssum on-ink" aria-label="Your Widgeta">
        <span class="ssum__label">Your Widgeta</span>

        <ul class="ssum__list">
          {included.map((i) => <li><span class="ssum__tick" aria-hidden="true">✓</span>{i.line}</li>)}
          <li class="ssum__pending" hidden data-notify-line>
            <span class="ssum__clock" aria-hidden="true">◷</span>
            Call answering — we'll email you at launch
          </li>
        </ul>

        <p class="ssum__price">
          <span class="ssum__amount">{price.display}</span>
        </p>
        <p class="ssum__per">per month · cancel anytime</p>

        <a class="btn btn--amber ssum__cta" href={`${APP_URL}/signup`}>
          Start now — about 2 minutes
        </a>
        <p class="ssum__fine">Live today · No contract · You own the site</p>
      </aside>
    </div>
  </section>

  <section class="section faq-sec">
    <div class="shell">
      <h2 class="faq-sec__h">Straight answers</h2>
      <FaqList items={faqs} variant="cards" />
    </div>
  </section>
  </div>
</Base>

<script>
  /*
   * The toggle only ever says "tell me later". It reveals the email field and
   * adds a pending line to the summary; it never touches the price, because
   * nothing here is for sale yet.
   */
  const toggle = document.querySelector('[data-notify-toggle]');
  const form = document.querySelector('[data-notify-form]');
  const done = document.querySelector('[data-notify-done]');
  const line = document.querySelector('[data-notify-line]');

  if (toggle instanceof HTMLInputElement && form instanceof HTMLFormElement) {
    toggle.addEventListener('change', () => {
      const on = toggle.checked;
      if (line instanceof HTMLElement) line.hidden = !on;
      form.hidden = !on || !(done instanceof HTMLElement && done.hidden);
      if (on) form.querySelector('input')?.focus();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      // TODO: post to the real capture endpoint once it exists.
      form.hidden = true;
      if (done instanceof HTMLElement) done.hidden = false;
    });
  }
</script>

