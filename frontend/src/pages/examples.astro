---
/**
 * Examples showcase.
 *
 * The spec wants this page to earn "best plumbing website examples", which
 * a wall of screenshots cannot do — so every card carries a "why it works"
 * line, and each trade gets its own H2 and commentary.
 *
 * Filtering is done with anchors and CSS rather than script: eight cards do
 * not need a runtime, and a link to /examples#hvac is something a person can
 * send to someone else. Without JavaScript every card is still on the page.
 */
import Base from '../layouts/Base.astro';
import '../styles/examples.css';
import Breadcrumb from '../components/Breadcrumb.astro';
import ClosingBand from '../components/ClosingBand.astro';

import { EXAMPLE_SITES, EXAMPLE_FILTERS, EXAMPLE_HEADINGS } from '../data/examples.js';
import { SITE_URL, APP_URL, PRIMARY_CTA, AR_SITE } from '../data/site.js';

const groups = EXAMPLE_FILTERS.filter((f) => f.key !== 'all').map((f) => ({
  ...f,
  heading: EXAMPLE_HEADINGS[f.key],
  sites: EXAMPLE_SITES.filter((s) => s.trade === f.key),
}));

const title = 'Best Trade Website Examples, by Trade | Widgeta';
const description =
  'Sample plumbing, HVAC, roofing and electrical websites built from a few answers — with what makes each one work. All businesses shown are samples.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Examples', item: `${SITE_URL}/examples` },
    ],
  },
];
---

<Base
  title={title}
  description={description}
  path="/examples"
  altPath={AR_SITE.built ? '/ar/examples' : undefined}
  schema={schema}
>
  <div class="expage">
  <div class="shell">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Examples' }]} />
  </div>

  <section class="head">
    <div class="shell">
      <h1>{EXAMPLE_HEADINGS.all[0]}</h1>
      <p class="head__sub">{EXAMPLE_HEADINGS.all[1]}</p>
      <p class="head__note muted">
        Every business, phone number and domain below is invented for
        illustration and labelled as a sample.
      </p>

      <nav class="filters" aria-label="Jump to a trade">
        {groups.map((g) => <a class="chip filters__chip" href={`#${g.key}`}>{g.label}</a>)}
      </nav>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="section group" id={g.key}>
        <div class="shell">
          <h2>{g.heading[0]}</h2>
          <p class="group__intro muted">{g.heading[1]}</p>

          <div class="grid-auto">
            {g.sites.map((ex) => (
              <article class="card ex">
                <div class="ex__chrome">
                  <span class="ex__domain">{ex.url}</span>
                  <span class="tag tag--sample">Sample</span>
                </div>

                <div class="ex__hero">
                  <strong class="ex__biz">{ex.name}</strong>
                  <span class="ex__areas">{ex.cities}</span>
                  <span class="ex__phone">{ex.phone}</span>
                </div>

                <ul class="ex__pages">
                  <li>{ex.p1}</li>
                  <li>{ex.p2}</li>
                  <li>{ex.p3}</li>
                </ul>

                <p class="ex__cap muted">
                  {ex.tradeLabel} · {ex.pages} pages · live in about a minute
                </p>
                <p class="ex__why">{ex.why}</p>
              </article>
            ))}

            <div class="card ex ex--yours">
              <span class="ex__yours-t">Yours goes here.</span>
              <span class="muted">Answer a few questions and see your own site today.</span>
              <a class="btn btn--amber" href={PRIMARY_CTA.href}>Start now</a>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <ClosingBand
    title="The next example could have your name on it."
    ctaLabel="Get your business online"
    ctaHref={`${APP_URL}/signup`}
  />
  </div>
</Base>
