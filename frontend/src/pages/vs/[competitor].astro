---
/**
 * Comparison template.
 *
 * An 840px column, because this page is read rather than scanned — someone
 * deciding where next month's marketing money goes.
 *
 * The tone rule from the brief is structural, not decorative: the table
 * marks the row where the competitor wins and the page says so in plain
 * words. Credibility is the strategy here; a comparison that never concedes
 * is an advert, and this audience recognises adverts.
 */
import Base from '../../layouts/Base.astro';
import '../../styles/vs.css';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FaqList from '../../components/FaqList.astro';
import ClosingBand from '../../components/ClosingBand.astro';

import { COMPARISON_CONTENT } from '../../data/comparisons.js';
import { SITE_URL, APP_URL, withPrice, COMPARISONS } from '../../data/site.js';

export function getStaticPaths() {
  return Object.keys(COMPARISON_CONTENT).map((competitor) => ({ params: { competitor } }));
}

const { competitor } = Astro.params;
const c = COMPARISON_CONTENT[competitor];
const p = (text) => withPrice(text);

const path = `/vs/${competitor}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Compare', item: `${SITE_URL}${path}` },
      { '@type': 'ListItem', position: 3, name: `Widgeta vs ${c.name}`, item: `${SITE_URL}${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: p(f.a) },
    })),
  },
];
---

<Base title={c.title} description={c.description} path={path} schema={schema}>
  <div class="vspage">
  <div class="col">
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Compare' },
        { label: `Widgeta vs ${c.name}` },
      ]}
    />

    <header class="intro">
      <h1>{c.h1}</h1>
      <p class="intro__p">{c.intro1}</p>
      <p class="intro__p">{c.intro2}</p>
    </header>

    <!-- The table ------------------------------------------------------- -->
    <div class="scroll-x table-wrap">
      <table class="cmp">
        <caption class="sr-only">Widgeta compared with {c.name}, row by row</caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">What is compared</span></th>
            <th scope="col" class="cmp__ours">Widgeta</th>
            <th scope="col">{c.name}</th>
          </tr>
        </thead>
        <tbody>
          {
            c.rows.map((r) => (
              <tr>
                <th scope="row">{r.k}</th>
                <td class="cmp__ours">{p(r.w)}</td>
                <td>
                  {r.a}
                  {r.theirWin && (
                    <span class="wins">{c.name} wins this one</span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="src muted">{c.sourceNote}</p>

    <!-- Who each is right for -------------------------------------------- -->
    <section class="section">
      <h2>Who each one is right for</h2>

      <div class="who">
        <div class="card who__col">
          <h3>{c.theirsTitle}</h3>
          <ul class="who__list">
            {c.theirs.map((line) => <li><span aria-hidden="true">·</span>{line}</li>)}
          </ul>
        </div>

        <div class="card who__col who__col--ours">
          <h3>{c.oursTitle}</h3>
          <ul class="who__list">
            {c.ours.map((line) => <li><span aria-hidden="true">·</span>{line}</li>)}
          </ul>
        </div>
      </div>

      <p class="callout">
        <strong>{c.calloutLead}</strong> {c.callout}
      </p>
    </section>

    <!-- FAQ ---------------------------------------------------------------- -->
    <section class="section">
      <h2 class="faq__h">Fair questions</h2>
      <FaqList items={c.faqs.map((f) => ({ q: f.q, a: p(f.a) }))} />
    </section>

    <!-- Sibling comparisons ------------------------------------------------ -->
    {
      COMPARISONS.filter((o) => o.built && o.slug !== competitor).length > 0 && (
        <section class="section others">
          <h2 class="others__h">Compare something else</h2>
          <div class="others__row">
            {COMPARISONS.filter((o) => o.built && o.slug !== competitor).map((o) => (
              <a class="chip others__chip" href={`/vs/${o.slug}`}>Widgeta vs {o.name}</a>
            ))}
          </div>
        </section>
      )
    }
  </div>

  <ClosingBand
    title="Stop renting your customers. Start owning them."
    ctaLabel="Get your business online"
    ctaHref={`${APP_URL}/signup`}
  />
  </div>
</Base>

