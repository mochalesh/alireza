---
/**
 * Arabic pillar guide.
 *
 * The deepest pages in the Arabic tree, and the only ones a visitor reads
 * rather than scans — so the same 640px measure, table of contents and
 * sticky chapter chips as the English guide, from the same stylesheet. The
 * chips mirror on their own: they are laid out in logical properties.
 *
 * Exactly one commercial link per guide, in the chapter where it belongs.
 * `maintenance-marketing` and `local-seo` put it in the chapter about the
 * monthly work; `ac-marketing` puts it in the quiet-season chapter, where a
 * contractor reading in October is actually deciding something. Everything
 * else on these pages has no pitch in it at all.
 *
 * The "keep reading" block links only to posts that exist. A guide teasing
 * three articles and delivering one is the sort of small dishonesty that
 * costs more trust than it buys clicks.
 */
import Base from '../../../layouts/Base.astro';
import '../../../styles/guide.css';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Prose from '../../../components/Prose.astro';

import { SITE_URL, withPrice } from '../../../data/site.js';
import { AR, AR_TRADES, AR_GUIDES_INDEX } from '../../../data/ar/site.js';
import { AR_GUIDES } from '../../../data/ar/guides.js';
import { AR_POSTS } from '../../../data/ar/posts.js';

export function getStaticPaths() {
  return AR_GUIDES_INDEX.filter((g) => g.built && AR_GUIDES[g.slug]).map((g) => ({
    params: { guide: g.slug },
  }));
}

const { guide } = Astro.params;
const g = AR_GUIDES[guide];
const path = `${AR}/guides/${guide}`;

const tradeEntry = AR_TRADES.find((t) => t.slug === g.trade && t.built);

/* Supporting posts: the ones that exist and point back at this guide. */
const related = Object.entries(AR_POSTS)
  .filter(([, post]) => post.pillar === guide)
  .map(([slug, post]) => ({ slug, ...post }));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: g.h1,
    description: g.metaDesc,
    author: { '@type': 'Organization', name: g.author },
    publisher: { '@type': 'Organization', name: 'ويدجيتا', url: `${SITE_URL}${AR}` },
    datePublished: g.updated,
    dateModified: g.updated,
    mainEntityOfPage: `${SITE_URL}${path}`,
    inLanguage: 'ar',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE_URL}${AR}` },
      { '@type': 'ListItem', position: 2, name: 'الأدلة', item: `${SITE_URL}${path}` },
      { '@type': 'ListItem', position: 3, name: g.h1, item: `${SITE_URL}${path}` },
    ],
  },
];
---

<Base title={g.title} description={g.metaDesc} path={path} lang="ar" schema={schema}>
  <div class="guidepage">
    <div class="shell">
      <Breadcrumb
        items={[
          { label: 'الرئيسية', href: AR },
          { label: 'الأدلة' },
          { label: g.tradeLabel },
        ]}
      />
    </div>

    <!-- Chapter chips, sticky under the header -------------------------- -->
    <nav class="chips" aria-label="الفصول">
      <div class="chips__in">
        {g.chapters.map((c) => (
          <a class="chips__chip" href={`#c${c.n}`}>{c.n} · {c.chip}</a>
        ))}
      </div>
    </nav>

    <article class="col">
      <header class="head">
        <p class="eyebrow">دليل · {g.tradeLabel}</p>
        <h1>{g.h1}</h1>
        <p class="head__stand">{g.standfirst}</p>
        <p class="byline muted">
          <strong>{g.author}</strong> · {g.authorNote}
          <span class="byline__sep">·</span>
          حُدِّث في {g.updatedLabel} · {g.readingTime}
        </p>
      </header>

      <nav class="toc" aria-label="في هذا الدليل">
        <span class="toc__label">في هذا الدليل</span>
        <ol class="toc__list">
          {g.chapters.map((c) => (
            <li><a href={`#c${c.n}`}>{c.h2}</a></li>
          ))}
        </ol>
      </nav>

      {
        g.chapters.map((c) => (
          <section class="chapter" id={`c${c.n}`}>
            <span class="chapter__n">الفصل {c.n}</span>
            <h2 class="chapter__h">{c.h2}</h2>

            <Prose blocks={c.blocks.filter((b) => b.type !== 'cta')} lang="ar" />

            {
              /* The single commercial link, and only where the hub it points
                 at has actually been built. */
              c.blocks
                .filter((b) => b.type === 'cta' && tradeEntry)
                .map((b) => (
                  <aside class="cta">
                    <span class="cta__label">{b.label}</span>
                    <p class="cta__text">{withPrice(b.text, 'ar')}</p>
                    <a class="cta__link" href={`${AR}/for/${tradeEntry.slug}`}>
                      شاهد ويدجيتا لـ{tradeEntry.name}<span aria-hidden="true"> ←</span>
                    </a>
                  </aside>
                ))
            }
          </section>
        ))
      }

      {
        related.length > 0 && (
          <section class="keep">
            <h2 class="keep__h">اقرأ أيضاً</h2>
            <div class="keep__grid">
              {related.map((post) => (
                <a class="card keep__card" href={`${AR}/blog/${post.slug}`}>
                  <span class="keep__tags">{post.tags.join(' · ')}</span>
                  <span class="keep__title">{post.h1}</span>
                  <span class="muted keep__stand">{post.standfirst}</span>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </article>
  </div>
</Base>
