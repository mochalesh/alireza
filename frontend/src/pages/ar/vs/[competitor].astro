---
/**
 * Arabic comparison template.
 *
 * The same 840px reading column and the same stylesheet as the English one.
 * What differs is who is being compared: Angi and Thumbtack do not sell in
 * the Gulf, so these three pages weigh Widgeta against what a contractor
 * here actually considers — building it himself on Wix, commissioning a
 * WordPress site, or buying a one-off site from a freelancer.
 *
 * The tone rule is structural rather than decorative and it carries over
 * unchanged: the table marks the row where the other option genuinely wins
 * and the page says so in plain Arabic. A comparison that never concedes is
 * an advert, and this audience recognises adverts.
 *
 * No hreflang pair. The English comparisons name different companies, so
 * there is no equivalent page to point at — and a wrong pair is worse than
 * none.
 */
import Base from '../../../layouts/Base.astro';
import '../../../styles/vs.css';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FaqList from '../../../components/FaqList.astro';
import ClosingBand from '../../../components/ClosingBand.astro';

import { SITE_URL, PRIMARY_CTA } from '../../../data/site.js';
import { AR, AR_COMPARISONS, AR_PRIMARY_CTA } from '../../../data/ar/site.js';
import { AR_COMPARISON_CONTENT } from '../../../data/ar/comparisons.js';

export function getStaticPaths() {
  return AR_COMPARISONS.filter((c) => c.built && AR_COMPARISON_CONTENT[c.slug]).map((c) => ({
    params: { competitor: c.slug },
  }));
}

const { competitor } = Astro.params;
const c = AR_COMPARISON_CONTENT[competitor];
const path = `${AR}/vs/${competitor}`;

const others = AR_COMPARISONS.filter((o) => o.built && o.slug !== competitor);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE_URL}${AR}` },
      { '@type': 'ListItem', position: 2, name: 'المقارنات', item: `${SITE_URL}${path}` },
      { '@type': 'ListItem', position: 3, name: `ويدجيتا مقابل ${c.name}`, item: `${SITE_URL}${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'ar',
    mainEntity: c.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base title={c.title} description={c.metaDesc} path={path} lang="ar" schema={schema}>
  <div class="vspage">
    <div class="col">
      <Breadcrumb
        items={[
          { label: 'الرئيسية', href: AR },
          { label: 'المقارنات' },
          { label: `ويدجيتا مقابل ${c.name}` },
        ]}
      />

      <header class="intro">
        <h1>{c.h1}</h1>
        <p class="intro__p">{c.intro1}</p>
        <p class="intro__p">{c.intro2}</p>
      </header>

      <!-- The table ------------------------------------------------------- -->
      <div class="scroll-x table-wrap">
        <table class="cmp">
          <caption class="sr-only">ويدجيتا مقارنة بـ{c.name}، بنداً بنداً</caption>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">وجه المقارنة</span></th>
              <th scope="col" class="cmp__ours">{c.cols[0]}</th>
              <th scope="col">{c.cols[1]}</th>
            </tr>
          </thead>
          <tbody>
            {
              c.rows.map((r) => (
                <tr>
                  <th scope="row">{r.k}</th>
                  <td class="cmp__ours">{r.w}</td>
                  <td>
                    {r.a}
                    {r.theirWin && <span class="wins">{c.name} يتفوق هنا</span>}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="src muted">{c.sourceNote}</p>

      <!-- Who each is right for -------------------------------------------- -->
      <section class="section">
        <h2>لمن يناسب كل خيار</h2>

        <div class="who">
          <div class="card who__col">
            <h3>{c.theirsTitle}</h3>
            <ul class="who__list">
              {c.theirs.map((line) => <li><span aria-hidden="true">·</span>{line}</li>)}
            </ul>
          </div>

          <div class="card who__col who__col--ours">
            <h3>{c.oursTitle}</h3>
            <ul class="who__list">
              {c.ours.map((line) => <li><span aria-hidden="true">·</span>{line}</li>)}
            </ul>
          </div>
        </div>

        <p class="callout">
          <strong>{c.calloutLead}</strong> {c.callout}
        </p>
      </section>

      <!-- FAQ ---------------------------------------------------------------- -->
      <section class="section">
        <h2 class="faq__h">أسئلة عادلة</h2>
        <FaqList items={c.faqs} />
      </section>

      <!-- Sibling comparisons ------------------------------------------------ -->
      {
        others.length > 0 && (
          <section class="section others">
            <h2 class="others__h">قارن بشيء آخر</h2>
            <div class="others__row">
              {others.map((o) => (
                <a class="chip others__chip" href={`${AR}/vs/${o.slug}`}>ويدجيتا مقابل {o.name}</a>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <ClosingBand
      title={c.close}
      ctaLabel={AR_PRIMARY_CTA.label}
      ctaHref={PRIMARY_CTA.href}
      fine="بدون عقد · كل شيء ملكك"
    />
  </div>
</Base>
